# Copy to .env and adjust. docker-compose reads these; never commit a real .env.

# --- Postgres ---
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener        # CHANGE in any non-local environment
POSTGRES_DB=shortener

# --- App ---
DATABASE_URL=postgresql://shortener:shortener@localhost:5432/shortener
BASE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0

# --- Rate limiting ---
RATE_LIMIT_SHORTEN=30/minute
RATE_LIMIT_REDIRECT=120/minute
# Enable ONLY behind a proxy you control (Phase 3 Nginx) so X-Forwarded-For is trusted.
TRUST_PROXY=false

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Analytics ---
ANALYTICS_STREAM_MAXLEN=100000
